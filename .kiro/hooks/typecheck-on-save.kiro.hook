{
  "enabled": true,
  "name": "Typecheck app on save",
  "description": "When a TypeScript file under app/src is saved, run the app typecheck (tsc --noEmit) and report errors. Read-only: never commits, pushes or deploys.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "app/src/**/*.ts",
      "app/src/**/*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npm --prefix app run typecheck"
  }
}
