{
  "name": "rdd-landing",
  "private": true,
  "version": "0.1.0",
  "description": "Landing page for Rare Disease Detective. Built to landing/dist and served at / (the app is served at /app/).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:i18n": "node --test --experimental-strip-types src/i18n/messages.test.ts"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.1",
    "@fontsource/noto-sans-kr": "5.3.1",
    "@fontsource/noto-sans-sc": "5.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
