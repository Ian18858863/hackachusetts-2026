{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "description": "App shell for the Hackachusetts 2026 team project (topic-neutral until the topic is chosen).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:i18n": "node --test --experimental-strip-types src/shared/i18n/messages.test.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "@fontsource/noto-serif-jp": "5.3.1",
    "@fontsource/noto-serif-kr": "5.3.1",
    "@fontsource/noto-serif-sc": "5.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
